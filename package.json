{
  "name": "marktplaner",
  "private": true,
  "version": "0.1.0",
  "description": "Maßstabsgetreue Marktpläne für Märkte und Feste: Freiflächen, Nummern, Strom und PDF-Export",
  "license": "AGPL-3.0-or-later",
  "author": "Laurin Ludwig",
  "homepage": "https://laurinludwig.github.io/Marktplaner/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LaurinLudwig/Marktplaner.git"
  },
  "bugs": {
    "url": "https://github.com/LaurinLudwig/Marktplaner/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/core",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "lint": "oxlint --deny-warnings",
    "test:e2e": "playwright test",
    "test:perf": "playwright test --config playwright.perf.config.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tauri-apps/api": "^2.12.2",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "fflate": "^0.8.3",
    "immer": "^11.1.21",
    "nanoid": "^6.0.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@material-symbols/svg-400": "^0.48.0",
    "@playwright/test": "^1.64.0",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fast-check": "^4.10.2",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
