{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Marktplaner",
  "version": "0.1.0",
  "identifier": "de.laurinludwig.marktplaner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Marktplaner",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' blob: data: ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Marktplan-Editor",
    "publisher": "Laurin Ludwig",
    "homepage": "https://github.com/LaurinLudwig/Marktplaner",
    "license": "AGPL-3.0-or-later",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      { "ext": ["mplan", "schelme"], "name": "Marktplaner-Projekt", "description": "Marktplaner-Projekt", "role": "Editor", "mimeType": "application/x-marktplaner" }
    ]
  }
}
